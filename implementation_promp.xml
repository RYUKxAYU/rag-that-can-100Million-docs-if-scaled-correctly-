        <Rule priority="critical">
            Retrieval must support iterative refinement loops.
        </Rule>

        <Rule priority="critical">
            Retrieval confidence must be evaluated after every retrieval cycle.
        </Rule>

        <Rule priority="high">
            Query rewriting must occur automatically when retrieval quality is insufficient.
        </Rule>

